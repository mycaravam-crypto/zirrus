root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,ts,tsx,js,mjs,css,html}]
indent_size = 2

# EF Core migrations are generated and reviewed as SQL (ADR 0005); keep analyzers off them.
[**/Migrations/*.cs]
generated_code = true

# Test names use underscores for readability; test classes are public for the test framework.
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1515.severity = none
