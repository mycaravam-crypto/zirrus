{
  "openapi": "3.1.1",
  "info": {
    "title": "ZIRRUS API",
    "version": "v1"
  },
  "paths": {
    "/api/v1/me": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Get the signed-in user and whether they are an organization administrator",
        "operationId": "GetMe",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserInfo"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/antiforgery": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Get the CSRF token for unsafe requests and the logout form",
        "operationId": "GetCsrfToken",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfToken"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalogs": {
      "get": {
        "tags": [
          "Catalogs"
        ],
        "summary": "List the catalogs the caller may see, with their access level",
        "description": "Organization administrators see every catalog; other users see the catalogs they hold a role in.",
        "operationId": "ListCatalogs",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CatalogSummary"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Catalogs"
        ],
        "summary": "Create a catalog (organization administrators only)",
        "operationId": "CreateCatalog",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCatalogRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogSummary"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalogs/{catalogId}/members/{subject}": {
      "put": {
        "tags": [
          "Catalogs"
        ],
        "summary": "Grant or change a user's role in a catalog (organization administrators only)",
        "operationId": "SetCatalogMember",
        "parameters": [
          {
            "name": "catalogId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "subject",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetCatalogMemberRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogMember"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Catalogs"
        ],
        "summary": "Remove a user's role in a catalog (organization administrators only)",
        "operationId": "RemoveCatalogMember",
        "parameters": [
          {
            "name": "catalogId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "subject",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalogs/{catalogId}/assets": {
      "get": {
        "tags": [
          "Assets"
        ],
        "summary": "List a catalog's assets, newest first (viewers see active assets only)",
        "description": "Cursor pagination: pass nextCursor from the previous page; limit 1–200, default 50. Search and filters follow in W5.",
        "operationId": "ListAssets",
        "parameters": [
          {
            "name": "catalogId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetPage"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Assets"
        ],
        "summary": "Upload a JPEG, PNG or WebP image into quarantine (editors)",
        "description": "multipart/form-data with one part named 'file'; send the CSRF token in X-CSRF-TOKEN. The format is detected from the content. The response lists duplicates in the catalog by SHA-256.",
        "operationId": "UploadAsset",
        "parameters": [
          {
            "name": "catalogId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/IFormFile"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "413": {
            "description": "Payload Too Large",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalogs/{catalogId}/assets/{assetId}/retry": {
      "post": {
        "tags": [
          "Assets"
        ],
        "summary": "Retry processing of a failed or stalled asset (editors)",
        "operationId": "RetryAsset",
        "parameters": [
          {
            "name": "catalogId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "assetId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalogs/{catalogId}/assets/{assetId}/content": {
      "get": {
        "tags": [
          "Assets"
        ],
        "summary": "Download the original of an active asset, optionally a byte range",
        "operationId": "DownloadAsset",
        "parameters": [
          {
            "name": "catalogId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "assetId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "206": {
            "description": "Partial Content"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "416": {
            "description": "Range Not Satisfiable"
          }
        }
      }
    },
    "/api/v1/catalogs/{catalogId}/assets/{assetId}/renditions/{kind}": {
      "get": {
        "tags": [
          "Assets"
        ],
        "summary": "Download the thumbnail or preview of an active asset",
        "operationId": "GetRendition",
        "parameters": [
          {
            "name": "catalogId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "assetId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "kind",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalogs/{catalogId}/assets/{assetId}": {
      "get": {
        "tags": [
          "Assets"
        ],
        "summary": "Read one asset with its state, checksum, metadata and ETag",
        "description": "Viewers see active assets only; editors also see pending, rejected and failed ones. The ETag carries the revision for If-Match.",
        "operationId": "GetAsset",
        "parameters": [
          {
            "name": "catalogId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "assetId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalogs/{catalogId}/assets/{assetId}/metadata": {
      "put": {
        "tags": [
          "Assets"
        ],
        "summary": "Replace an asset's metadata (editors)",
        "description": "Send the ETag from GET in If-Match. A stale ETag returns 412 and changes nothing.",
        "operationId": "ReplaceAssetMetadata",
        "parameters": [
          {
            "name": "catalogId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "assetId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JsonElement"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetDetails"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "412": {
            "description": "Precondition Failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "428": {
            "description": "Precondition Required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssetDetails": {
        "required": [
          "id",
          "catalogId",
          "fileName",
          "mediaType",
          "sizeBytes",
          "sha256",
          "state",
          "statusReason",
          "metadata",
          "revision",
          "createdAt",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Asset identifier.",
            "format": "uuid"
          },
          "catalogId": {
            "type": "string",
            "description": "Catalog.",
            "format": "uuid"
          },
          "fileName": {
            "type": "string",
            "description": "Original file name."
          },
          "mediaType": {
            "type": "string",
            "description": "Media type."
          },
          "sizeBytes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "description": "Size of the original, once stored.",
            "format": "int64"
          },
          "sha256": {
            "type": [
              "null",
              "string"
            ],
            "description": "SHA-256 of the original, once stored."
          },
          "state": {
            "type": "string",
            "description": "Lifecycle state in lowercase, e.g. `active`."
          },
          "statusReason": {
            "type": [
              "null",
              "string"
            ],
            "description": "Reason for rejected or failed assets."
          },
          "metadata": {
            "description": "User metadata as a JSON object.",
            "$ref": "#/components/schemas/JsonElement"
          },
          "revision": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Current revision; the ETag is its quoted form.",
            "format": "int32"
          },
          "createdAt": {
            "type": "string",
            "description": "Creation time (UTC).",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "description": "Last change (UTC).",
            "format": "date-time"
          }
        },
        "description": "Asset as returned by the API."
      },
      "AssetPage": {
        "required": [
          "items",
          "nextCursor"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssetSummary"
            },
            "description": "Assets on this page."
          },
          "nextCursor": {
            "type": [
              "null",
              "string"
            ],
            "description": "Opaque cursor for the next page, or null at the end."
          }
        },
        "description": "One page of a catalog's assets, newest first."
      },
      "AssetSummary": {
        "required": [
          "id",
          "fileName",
          "mediaType",
          "sizeBytes",
          "state",
          "statusReason",
          "createdAt",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Asset identifier.",
            "format": "uuid"
          },
          "fileName": {
            "type": "string",
            "description": "Original file name."
          },
          "mediaType": {
            "type": "string",
            "description": "Media type."
          },
          "sizeBytes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "description": "Size of the original, once stored.",
            "format": "int64"
          },
          "state": {
            "type": "string",
            "description": "Lifecycle state in lowercase."
          },
          "statusReason": {
            "type": [
              "null",
              "string"
            ],
            "description": "Reason for rejected or failed assets."
          },
          "createdAt": {
            "type": "string",
            "description": "Upload time (UTC).",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "description": "Last change (UTC).",
            "format": "date-time"
          }
        },
        "description": "An asset in a list (grid view)."
      },
      "CatalogMember": {
        "required": [
          "subject",
          "role",
          "grantedAt"
        ],
        "type": "object",
        "properties": {
          "subject": {
            "type": "string",
            "description": "Identity-provider subject."
          },
          "role": {
            "type": "string",
            "description": "Role name: `editor` or `viewer`."
          },
          "grantedAt": {
            "type": "string",
            "description": "When the role was granted (UTC).",
            "format": "date-time"
          }
        },
        "description": "A catalog member as returned to administrators."
      },
      "CatalogSummary": {
        "required": [
          "id",
          "name",
          "createdAt",
          "access"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Catalog identifier.",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "description": "Display name."
          },
          "createdAt": {
            "type": "string",
            "description": "Creation time (UTC).",
            "format": "date-time"
          },
          "access": {
            "type": "string",
            "description": "The caller's access: `admin`, `editor` or `viewer`."
          }
        },
        "description": "Read model returned by catalog queries."
      },
      "CreateCatalogRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Catalog name, 1–200 characters, unique in the organization."
          }
        },
        "description": "Request to create a catalog."
      },
      "CsrfToken": {
        "required": [
          "token",
          "formFieldName"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Value to send in the `X-CSRF-TOKEN` header or the logout form field."
          },
          "formFieldName": {
            "type": "string",
            "description": "Form field name for the logout form."
          }
        },
        "description": "Antiforgery token for the SPA, as returned by `GET /api/v1/antiforgery`."
      },
      "CurrentUserInfo": {
        "required": [
          "subject",
          "name",
          "isOrganizationAdmin"
        ],
        "type": "object",
        "properties": {
          "subject": {
            "type": "string",
